# ---------- Core ----------
DATABASE_URL="postgresql://reason:reason@localhost:5432/reason_support"
# Public base URL of this app (used in README webhook instructions / links)
APP_URL="http://localhost:3000"

# ---------- Auth ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Only emails on this domain may sign in (Google and password)
ALLOWED_EMAIL_DOMAIN="reasonclothing.com"
# Optional Google login (leave empty to disable the button)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- Gorgias ----------
GORGIAS_DOMAIN="reason-clothing"          # -> https://reason-clothing.gorgias.com
GORGIAS_EMAIL=""                          # email of the user that owns the API key
GORGIAS_API_KEY=""
# Shared secret the Gorgias HTTP integration sends in the X-Webhook-Secret header
GORGIAS_WEBHOOK_SECRET=""
# On first sync, import tickets updated in the last N days
GORGIAS_BACKFILL_DAYS=14
# Polling interval for the worker (cron syntax). Default: every 3 minutes
GORGIAS_POLL_CRON="*/3 * * * *"
# Max Gorgias API calls per 20s window, per process (Gorgias allows 40 for API keys)
GORGIAS_RATE_LIMIT=30

