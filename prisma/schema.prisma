generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
}

/// People who can log into this platform.
model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String?
  passwordHash   String?
  role           Role          @default(AGENT)
  active         Boolean       @default(true)
  /// Matching Gorgias user id (resolved by email) – used for "Assign to me" and as message sender
  gorgiasUserId  Int?
  createdAt      DateTime      @default(now())
  lastLoginAt    DateTime?
  activities     ActivityLog[]
  handledProblems OrderProblem[]
}

/// Gorgias helpdesk users (agents), synced from the API.
model GorgiasAgent {
  id        Int      @id
  email     String
  name      String?
  role      String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// Gorgias customer (local cache).
model Customer {
  id          Int      @id
  email       String?
  name        String?
  demo        Boolean  @default(false)
  /// VIP flag (from tags now; from Shopify order history in phase 3)
  vip         Boolean  @default(false)
  ordersCount Int?
  totalSpent  Decimal? @db.Decimal(12, 2)
  tickets     Ticket[]
  updatedAt   DateTime @updatedAt

  @@index([email])
}

/// Gorgias ticket (local cache) plus derived conversation state.
model Ticket {
  id                    Int             @id
  status                String
  priority              String?
  channel               String?
  subject               String?
  customerId            Int?
  customer              Customer?       @relation(fields: [customerId], references: [id])
  assigneeUserId        Int?
  assigneeName          String?
  assigneeTeamId        Int?
  assigneeTeamName      String?
  tags                  String[]
  spam                  Boolean         @default(false)
  messagesCount         Int             @default(0)
  /// Customer messages after the last real agent reply
  unansweredCount       Int             @default(0)
  firstUnansweredAt     DateTime?
  lastCustomerMessageAt DateTime?
  lastAgentReplyAt      DateTime?
  lastMessageAt         DateTime?
  gorgiasCreatedAt      DateTime
  gorgiasUpdatedAt      DateTime
  snoozedUntil          DateTime?
  messagesSyncedAt      DateTime?
  /// Order numbers mentioned in the ticket (e.g. "#RC10482" -> "10482")
  orderNumbers          String[]
  /// Shopify order linked to this ticket (by order number or customer email), set by scoring
  linkedOrderId         String?
  linkedOrder           ShopifyOrder?   @relation(fields: [linkedOrderId], references: [id], onDelete: SetNull)
  demo                  Boolean         @default(false)
  messages              TicketMessage[]
  score                 TicketScore?
  syncedAt              DateTime        @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([gorgiasUpdatedAt])
}

model TicketMessage {
  id          Int      @id
  ticketId    Int
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromAgent   Boolean
  isPublic    Boolean  @default(true)
  channel     String?
  via         String?
  senderEmail String?
  senderName  String?
  bodyText    String?  @db.Text
  createdAt   DateTime

  @@index([ticketId, createdAt])
}

/// Incoming webhook payloads (Gorgias now, Shopify in phase 3). Processed async.
model WebhookEvent {
  id          String    @id @default(cuid())
  source      String
  topic       String?
  payload     Json
  status      String    @default("pending") // pending | done | error
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
}

/// Cursor / last-run bookkeeping for background jobs.
model SyncState {
  key       String   @id
  value     String?
  lastRunAt DateTime?
  lastError String?
  updatedAt DateTime @updatedAt
}

/// Configurable settings (JSON values). Fully editable in phase 5.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Every action taken through the platform.
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Urgency score for a ticket (recomputed on every sync and every few minutes).
model TicketScore {
  ticketId       Int       @id
  ticket         Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  score          Int
  /// [{ code, label, points, tone }]
  reasons        Json
  /// Threat categories detected: legal, chargeback, fraud, public, escalation
  threats        String[]
  threatAt       DateTime?
  aiReason       String?
  aiResult       Json?
  aiHash         String?
  aiCheckedAt    DateTime?
  computedAt     DateTime  @default(now())
  /// Slack alert bookkeeping (reset when an agent replies)
  alertedAt      DateTime?
  alertedScore   Int?
  threatAlertedAt DateTime?

  @@index([score])
}

// ---------------------------------------------------------------- Shopify (phase 3)

model Store {
  key       String         @id
  name      String
  domain    String         @unique
  demo      Boolean        @default(false)
  orders    ShopifyOrder[]
  updatedAt DateTime       @updatedAt
}

model ShopifyOrder {
  /// Shopify GID, e.g. gid://shopify/Order/123
  id                  String            @id
  storeKey            String
  store               Store             @relation(fields: [storeKey], references: [key])
  /// Display name, e.g. "#RC10482"
  name                String
  /// Digits of the name, e.g. "10482" – used to match order numbers mentioned in tickets
  number              String
  email               String?
  customerId          String?
  customerName        String?
  customerOrdersCount Int?
  customerAmountSpent Decimal?          @db.Decimal(12, 2)
  shopifyCreatedAt    DateTime
  shopifyUpdatedAt    DateTime
  cancelledAt         DateTime?
  cancelReason        String?
  financialStatus     String?
  fulfillmentStatus   String?
  totalPrice          Decimal           @db.Decimal(12, 2)
  totalRefunded       Decimal           @default(0) @db.Decimal(12, 2)
  currency            String?
  closed              Boolean           @default(false)
  test                Boolean           @default(false)
  tags                String[]
  demo                Boolean           @default(false)
  lineItems           ShopifyLineItem[]
  problems            OrderProblem[]
  tickets             Ticket[]
  syncedAt            DateTime          @updatedAt

  @@index([storeKey, number])
  @@index([email])
  @@index([cancelledAt])
}

model ShopifyLineItem {
  id                  String       @id
  orderId             String
  order               ShopifyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku                 String?
  title               String
  variantTitle        String?
  variantId           String?
  inventoryItemId     String?
  tracked             Boolean      @default(true)
  quantity            Int
  unfulfilledQuantity Int

  @@index([inventoryItemId])
  @@index([sku])
}

/// Inventory per item and location (only items that appear on open orders are synced).
model InventoryLevel {
  id              String   @id @default(cuid())
  storeKey        String
  inventoryItemId String
  locationId      String
  locationName    String?
  sku             String?
  tracked         Boolean  @default(true)
  available       Int
  onHand          Int
  committed       Int
  updatedAt       DateTime @updatedAt

  @@unique([storeKey, inventoryItemId, locationId])
  @@index([storeKey, sku])
}

enum ProblemType {
  CANCELLED
  OUT_OF_STOCK
  OVERSOLD
  STUCK
}

enum ProblemStatus {
  OPEN
  NOTIFIED
  HANDLED
}

model OrderProblem {
  id             String        @id @default(cuid())
  orderId        String
  order          ShopifyOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeKey       String
  type           ProblemType
  /// Affected SKUs
  skus           String[]
  /// Type-specific data: reason/refund (cancelled), items + shortfall (stock), days open (stuck)
  details        Json
  status         ProblemStatus @default(OPEN)
  detectedAt     DateTime      @default(now())
  /// Set when the condition disappears (e.g. stock arrived, order fulfilled)
  resolvedAt     DateTime?
  contactedAt    DateTime?
  handledAt      DateTime?
  handledById    String?
  handledBy      User?         @relation(fields: [handledById], references: [id])
  linkedTicketId Int?

  @@unique([orderId, type])
  @@index([status, type])
  @@index([linkedTicketId])
}
